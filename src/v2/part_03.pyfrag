            losses.append(float(loss.item()))
        val_probability = predict_neural(model, train_values[inner_val], train_missing[inner_val])
        val_pr = average_precision_score(train_y[inner_val], val_probability)
        history.append((epoch, float(np.mean(losses)), float(val_pr)))
        if val_pr > best_score + 1e-5:
            best_score = val_pr
            best_state = {name: tensor.detach().cpu().clone() for name, tensor in model.state_dict().items()}
            stale = 0
        else:
            stale += 1
        if stale >= CFG['patience']:
            break

    model.load_state_dict(best_state)
    model.to(DEVICE)
    test_probability = predict_neural(model, test_values, test_missing)
    artifact = {
        'model_name': variant,
        'fold': fold,
        'train_idx': train_idx.tolist(),
        'test_idx': test_idx.tolist(),
        'preprocessor': prep,
        'state_dict': best_state,
        'history': history,
        'use_missing_embedding': use_missing_embedding,
        'corruption': corruption,
        'prediction': test_probability.astype(np.float32),
    }
    fold_result = {
        'model': variant,
        'fold': fold,
        'train_n': len(train_idx),
        'test_n': len(test_idx),
        'best_epoch': max(history, key=lambda item: item[2])[0],
        'inner_pr_auc': float(best_score),
        'ROC_AUC': float(roc_auc_score(y[test_idx], test_probability)),
        'PR_AUC': float(average_precision_score(y[test_idx], test_probability)),
        'Brier': float(brier_score_loss(y[test_idx], test_probability)),
    }
    return artifact, fold_result


def restore_neural(artifact):
    model = FeatureTokenTransformer(
        artifact['preprocessor'],
        use_missing_embedding=artifact['use_missing_embedding'],
        corruption=artifact['corruption'],
    )
    model.load_state_dict(artifact['state_dict'])
    return model.to(DEVICE).eval()

# -----------------------------------------------------------------------------
# 4. Five classical baselines + FT + ablation + proposed model on identical folds
# -----------------------------------------------------------------------------
CLASSICAL_NAMES = ['Logistic Regression', 'Random Forest', 'XGBoost', 'CatBoost', 'HistGradientBoosting']
NEURAL_NAMES = ['FT-Transformer', 'MAT-NoMissingEmbedding', 'MAT-Appendix']
ALL_MODELS = CLASSICAL_NAMES + NEURAL_NAMES

# HistGradientBoosting import kept local to make dependency explicit.
from sklearn.ensemble import HistGradientBoostingClassifier

def make_classical_model(name, fold, positive_weight):
    if name == 'Logistic Regression':
        return LogisticRegression(
            max_iter=4000,
            class_weight='balanced',
            solver='liblinear',
            random_state=SEED + fold,
        )
    if name == 'Random Forest':
        return RandomForestClassifier(
            n_estimators=220,
            max_depth=8,
            min_samples_leaf=3,
            class_weight='balanced_subsample',
            n_jobs=-1,
            random_state=SEED + fold,
        )
    if name == 'XGBoost':
        return XGBClassifier(
            n_estimators=260,
            max_depth=4,
            learning_rate=0.035,
            subsample=0.85,
            colsample_bytree=0.85,
            min_child_weight=3,
            reg_lambda=2.0,
            scale_pos_weight=positive_weight,
            eval_metric='logloss',
            n_jobs=-1,
            random_state=SEED + fold,
        )
    if name == 'CatBoost':
        return CatBoostClassifier(
            iterations=320,
            depth=5,
            learning_rate=0.035,
            loss_function='Logloss',
            auto_class_weights='Balanced',
            verbose=False,
            random_seed=SEED + fold,
            allow_writing_files=False,
        )
    if name == 'HistGradientBoosting':
        return HistGradientBoostingClassifier(
            learning_rate=0.055,
            max_iter=220,
            max_leaf_nodes=15,
            min_samples_leaf=12,
            l2_regularization=1.0,
            random_state=SEED + fold,
        )
    raise ValueError(name)

outer = StratifiedKFold(n_splits=CFG['folds'], shuffle=True, random_state=SEED)
fold_splits = [(train_idx, test_idx) for train_idx, test_idx in outer.split(X, y)]
oof_raw = {name: np.full(len(y), np.nan, dtype=np.float64) for name in ALL_MODELS}
fold_metrics_rows = []
neural_artifacts = {name: [] for name in NEURAL_NAMES}
classical_artifacts = {name: [] for name in CLASSICAL_NAMES}

for fold, (train_idx, test_idx) in enumerate(fold_splits, start=1):
    print(f'\n===== OUTER FOLD {fold}/{CFG["folds"]} =====')
    train_x = X.iloc[train_idx].reset_index(drop=True)
    test_x = X.iloc[test_idx].reset_index(drop=True)
    train_y = y[train_idx]
    prep = fit_preprocessor(train_x)
    train_values, train_missing = transform_frame(train_x, prep)
    test_values, test_missing = transform_frame(test_x, prep)
    train_matrix = matrix_for_classical(train_values, train_missing)
    test_matrix = matrix_for_classical(test_values, test_missing)
    positive_weight = max((len(train_y) - train_y.sum()) / max(train_y.sum(), 1), 1.0)

    for name in CLASSICAL_NAMES:
        model = make_classical_model(name, fold, positive_weight)
        if name == 'HistGradientBoosting':
            # Deterministic class balancing via sample weights.
            weights = np.where(train_y == 1, positive_weight, 1.0)
            model.fit(train_matrix, train_y, sample_weight=weights)
        else:
            model.fit(train_matrix, train_y)
        probability = model.predict_proba(test_matrix)[:, 1]
        oof_raw[name][test_idx] = probability
        classical_artifacts[name].append({
            'model_name': name,
            'fold': fold,
            'train_idx': train_idx.tolist(),
            'test_idx': test_idx.tolist(),
            'preprocessor': prep,
            'model': model,
            'prediction': probability.astype(np.float32),
        })
        fold_metrics_rows.append({
            'model': name,
            'fold': fold,
            'train_n': len(train_idx),
            'test_n': len(test_idx),
            'best_epoch': np.nan,
            'inner_pr_auc': np.nan,
            'ROC_AUC': roc_auc_score(y[test_idx], probability),
            'PR_AUC': average_precision_score(y[test_idx], probability),
            'Brier': brier_score_loss(y[test_idx], probability),
        })
        print(name, 'PR-AUC=', round(average_precision_score(y[test_idx], probability), 4))

    for variant in NEURAL_NAMES:
        print('Training', variant)
        artifact, result = train_neural_fold(train_idx, test_idx, fold, variant)
        neural_artifacts[variant].append(artifact)
        oof_raw[variant][test_idx] = artifact['prediction']
        fold_metrics_rows.append(result)
        torch.save(artifact['state_dict'], OUT/'models'/f'{variant.replace(" ","_")}_fold_{fold}.pt')
        print(variant, 'PR-AUC=', round(result['PR_AUC'], 4))

for name in ALL_MODELS:
    if not np.isfinite(oof_raw[name]).all():
        raise RuntimeError(f'Incomplete OOF predictions for {name}')
fold_metrics = pd.DataFrame(fold_metrics_rows)

# -----------------------------------------------------------------------------
# 5. Cross-fitted calibration, thresholds, complete metrics and confidence intervals
# -----------------------------------------------------------------------------
def safe_logit(probability):
    probability = np.clip(np.asarray(probability), 1e-6, 1-1e-6)
    return np.log(probability/(1-probability)).reshape(-1, 1)


