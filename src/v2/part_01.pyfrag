# -----------------------------------------------------------------------------
# 1. Direct URL-backed dataset load and confirmed-appendicitis cohort
# -----------------------------------------------------------------------------
data = fetch_ucirepo(id=938)
X_all = data.data.features.copy()
Y_all = data.data.targets.copy()

def clean_name(value):
    return str(value).strip().replace(' ', '_').replace('-', '_').replace('/', '_')

X_all.columns = [clean_name(c) for c in X_all.columns]
Y_all.columns = [clean_name(c) for c in Y_all.columns]

def find_column(df, exact):
    matches = [c for c in df.columns if c.lower() == exact.lower()]
    if not matches:
        raise KeyError(f'Required column {exact!r} was not found. Available: {list(df.columns)}')
    return matches[0]

diagnosis_col = find_column(Y_all, 'Diagnosis')
severity_col = find_column(Y_all, 'Severity')
diagnosis = Y_all[diagnosis_col].astype('string').str.strip().str.lower()
severity = Y_all[severity_col].astype('string').str.strip().str.lower()

confirmed = diagnosis.eq('appendicitis')
valid_severity = severity.isin(['complicated', 'uncomplicated'])
cohort_mask = confirmed & valid_severity
X = X_all.loc[cohort_mask].reset_index(drop=True)
y = severity.loc[cohort_mask].eq('complicated').astype(np.int8).to_numpy()
source_rows = X_all.index[cohort_mask].astype(str).tolist()

# Strict leakage audit: remove identifiers, post-decision variables, target variables,
# direct complication-defining variables and procedure/pathology variables.
BLOCK_EXACT = {
    'Length_of_Stay', 'Management', 'Severity', 'Diagnosis',
    'Diagnosis_Presumptive', 'Patient_ID', 'ID', 'Outcome', 'Discharge_Status'
}
BLOCK_PATTERNS = {
    'post_decision': ['severity', 'diagnos', 'management', 'length_of_stay', 'discharge', 'outcome'],
    'procedure_or_pathology': ['surg', 'operat', 'histopath', 'patholog', 'appendectomy'],
    'direct_complication_definition': ['perfor', 'abscess', 'gangren', 'complic', 'periton'],
}

def leakage_reason(column):
    low = column.lower()
    if column in BLOCK_EXACT or low in {'id', 'patientid', 'patient_id'}:
        return 'identifier/target/post-decision'
    for reason, patterns in BLOCK_PATTERNS.items():
        if any(token in low for token in patterns):
            return reason
    return ''

audit_rows, keep_columns = [], []
for column in X.columns:
    reason = leakage_reason(column)
    if reason:
        audit_rows.append([column, 'DROP', reason])
    else:
        audit_rows.append([column, 'KEEP', 'admission-time candidate'])
        keep_columns.append(column)
X = X[keep_columns].copy()

for column in X.select_dtypes(include=['object', 'string']).columns:
    X[column] = X[column].replace(
        r'^\s*(?:\?|na|n/a|nan|none|null|unknown|not available)\s*$',
        np.nan,
        regex=True,
    )

constant_columns = [c for c in X.columns if X[c].nunique(dropna=True) <= 1]
for column in constant_columns:
    audit_rows.append([column, 'DROP', 'constant/empty'])
X = X.drop(columns=constant_columns)
audit = pd.DataFrame(audit_rows, columns=['feature', 'action', 'reason']).drop_duplicates('feature', keep='last')

if len(y) < 200 or len(np.unique(y)) != 2:
    raise ValueError(f'Unexpected confirmed-appendicitis severity cohort: n={len(y)}, classes={np.unique(y)}')

hash_frame = X.astype('string').fillna('<NA>')
hash_frame['target'] = y.astype(str)
data_hash = hashlib.sha256(
    pd.util.hash_pandas_object(hash_frame, index=True).values.tobytes()
).hexdigest()

cohort = pd.DataFrame({
    'item': ['confirmed_appendicitis_rows', 'complicated', 'uncomplicated', 'prevalence', 'features', 'sha256'],
    'value': [len(y), int(y.sum()), int(len(y)-y.sum()), float(y.mean()), int(X.shape[1]), data_hash],
})
display(cohort)
display(audit.query("action == 'DROP'").reset_index(drop=True))

# -----------------------------------------------------------------------------
# 2. Fold-safe preprocessing
# -----------------------------------------------------------------------------
def is_numeric_series(series):
    if pd.api.types.is_numeric_dtype(series):
        return True
    nonmissing = series.notna().sum()
    if nonmissing == 0:
        return False
    converted = pd.to_numeric(series, errors='coerce')
    return converted.notna().sum() / nonmissing >= 0.95


def fit_preprocessor(df):
    prep = {'columns': list(df.columns), 'types': [], 'numeric': {}, 'categorical': {}, 'cardinalities': []}
    for column in prep['columns']:
        series = df[column]
        if is_numeric_series(series):
            numeric = pd.to_numeric(series, errors='coerce').astype(float)
            median = float(numeric.median()) if numeric.notna().any() else 0.0
            filled = numeric.fillna(median)
            mean = float(filled.mean())
            std = float(filled.std(ddof=0))
            if not np.isfinite(std) or std <= 1e-8:
                std = 1.0
            prep['types'].append('numeric')
            prep['numeric'][column] = (median, mean, std)
            prep['cardinalities'].append(0)
        else:
            values = sorted(series.dropna().astype(str).str.strip().unique())
