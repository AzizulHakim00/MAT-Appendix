import os,sys,subprocess,json,random,hashlib,shutil,tempfile,getpass,platform,warnings
from pathlib import Path
from datetime import datetime,timezone
subprocess.check_call([sys.executable,'-m','pip','install','-q','ucimlrepo','joblib','shap','lime','openpyxl'])
import numpy as np,pandas as pd,joblib,matplotlib.pyplot as plt,torch,torch.nn as nn
